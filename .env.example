# ==============================================================================
# SolarWise Frontend Environment Configuration Example
# Copy this file to .env.local for local development.
# Rule: Never place backend secrets or database credentials in frontend environment variables.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Environment name
VITE_APP_ENV=development

